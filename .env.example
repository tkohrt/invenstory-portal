# Inven(s)tory Portal — environment contract.
# Names only; real values live in .env.local (gitignored) and Vercel env vars.
# Keep this file in sync with every process.env.X referenced in the code.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=          # project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # anon key (browser; RLS still applies)
SUPABASE_URL=                      # server-side project URL (same value, server context)
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY — bypasses RLS; never expose to browser
SUPABASE_EMBED_URL=                # Supabase Edge Function URL for embeddings
EMBED_FN_SECRET=                   # shared secret for the embedding Edge Function

# --- App ---
NEXT_PUBLIC_APP_URL=               # e.g. https://portal.forgranted.com

# --- AI generation (provider-agnostic; see lib/server/llm.ts) ---
LLM_PROVIDER=                      # "bedrock" | "vertex" | unset (auto)
# AWS Bedrock (PORTAL_ prefix because Vercel reserves standard AWS_* names)
PORTAL_AWS_ACCESS_KEY_ID=
PORTAL_AWS_SECRET_ACCESS_KEY=
PORTAL_AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=          # optional bearer-token auth alternative
BEDROCK_CHAT_MODEL_ID=             # e.g. us.anthropic.claude-sonnet-4-5-...:0
# Google Vertex (fallback)
GOOGLE_APPLICATION_CREDENTIALS=    # path to service-account JSON (if used)
GOOGLE_VERTEX_CREDENTIALS=         # inline service-account JSON (if used)
VERTEX_PROJECT_ID=
VERTEX_REGION=
VERTEX_CLAUDE_MODEL=

# --- Email / notifications ---
RESEND_API_KEY=
SLACK_ADMIN_WEBHOOK_URL=
GROWTH_EMAILS_ENABLED=false        # keep false until growth-email review is done
